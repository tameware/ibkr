{
  "ibkr": {
    "host": "127.0.0.1",
    "port": 7496,
    "//": "Paper trading port = 7497"
  },

  "contract": {
    "symbol": "Your stock's ticker here",
    "sec_type": "STK",
    "currency": "USD",
    "primary_exchange": "Your stock's exchange here"
  },

  "strategy": {
    "market_timezone": "America/New_York",
    "market_open_hour": 9,
    "market_open_minute": 30,
    "market_close_hour": 16,
    "price_round_digits": 2,
    "loop_seconds": 10,
    "max_pos": 200,
    "mid_delta": 0.05,
    "tif": "DAY",
    "nbbo_coalesce_seconds": 4.0,
    "nbbo_coalesce_max_seconds": 10.0,
    "//": "Commit pending NBBO after quiet ticks, or at least every max interval if ticks never pause",
    "resync_debounce_seconds": 0.35,
    "//": "Min interval between full position/open-order snapshots and sync_orders",
    "never_sell_below_avg_cost": false,
    "//": "When true, sell limits are floored at ledger avg_cost_per_share (long positions only)"
  },

  "risk": {
    "ignored_error_codes": [2103, 2104, 2106, 2108, 2158],
    "ignore_error_substrings": ["data farm connection is broken"],
    "cancel_open_orders_on_shutdown": false
  },

  "logging": {
    "log_dir": "logs",
    "level": "INFO",
    "max_bytes": 5000000,
    "backup_count": 10,
    "console": true
  },

  "diagnostics": {
    "market_data_resubscribe_debounce_seconds": 1.0,
    "market_data_stall_seconds": 15.0,
    "log_tick_price_before_coalesce": true,
    "//": "Temporary: log each tickPrice tickType/price before NBBO coalesce"
  }
}
